  object.id = id;
  object.mosqueSupabaseId = reader.readString(offsets[1]);
  object.name = reader.readString(offsets[2]);
  object.supabaseId = reader.readString(offsets[3]);
  return object;
}

P _groupDeserializeProp<P>(
